# Copy to .env (chmod 600). Every setting is optional; defaults are in
# src/waypoint/config.py.

# Naolib/Okina API key ("Accès authentifié" plan). Without it the public plan
# is used: 1 request every 30 s, which the cache already respects.
# WAYPOINT_API_KEY=

# Minutes from home to the stop.
# WAYPOINT_WALK_MINUTES=3
